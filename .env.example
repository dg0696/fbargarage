# Non-secret eBay settings only. Secrets go in Windows Credential Manager:
#   python scripts/store_ebay_secrets.py --set EBAY_CLIENT_ID
#   python scripts/store_ebay_secrets.py --status
# Never commit Client Secret, tokens, or RuName values.

# sandbox | production
EBAY_API_ENV=production

# TrueNAS MySQL (same dota user as cogs / spamalot-builder / Resume-Builder)
DB_HOST=truenas.local
DB_PORT=3306
DB_NAME=ebay_store
DB_USER=dota
DB_PASSWORD=

# LAN UI
APP_HOST=127.0.0.1
APP_PORT=5057

# Optional: vision drafts for listing fields (also accepted in docker.env)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: eBay business policy IDs if no active listing exists to copy from
# EBAY_SHIPPING_PROFILE_ID=
# EBAY_RETURN_PROFILE_ID=
# EBAY_PAYMENT_PROFILE_ID=
# EBAY_POSTAL_CODE=
# EBAY_LOCATION=
